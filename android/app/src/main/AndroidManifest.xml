<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Priority 3 & 4: Telephony & Call State Permissions -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" tools:ignore="ProtectedPermissions" />

    <!-- Audio Recording (For controlled speakerphone demonstration) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications for Real-time Fraud Alerts (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground Service to keep monitoring active during live calls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- Optional Floating Overlay for Immediate In-Call Warning -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Network state for communicating with local/laptop backend during testing -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="SvaraX"
        android:supportsRtl="true"
        android:theme="@style/Theme.SvaraX"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Main Dashboard Activity (Priority 2 & 3) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SvaraX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live In-Call Warning Screen (Priority 9, 12, 14) -->
        <activity
            android:name=".ui.LiveCallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SvaraX" />

        <!-- Call History Screen (Priority 12) -->
        <activity
            android:name=".ui.CallHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SvaraX" />

        <!-- Protection Settings Screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SvaraX" />

        <!-- Official Android Call Screening Service (Priority 4) -->
        <service
            android:name=".call.SvaraCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Fallback/Broadcast Telephony State Receiver (Priority 4) -->
        <receiver
            android:name=".call.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Foreground Call Monitoring & Analysis Service (Priority 4 & 5) -->
        <service
            android:name=".service.CallMonitoringService"
            android:foregroundServiceType="phoneCall|microphone"
            android:exported="false" />

    </application>
</manifest>
