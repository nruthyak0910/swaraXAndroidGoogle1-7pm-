<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface_card">

        <ImageButton
            android:id="@+id/btnBackDiagnostics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="System &amp; Audio Diagnostics"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshDiagnostics"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh"
            android:textColor="@color/accent_green"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Subsystem Status Card (Physical Environment Matrix) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHYSICAL ENVIRONMENT MATRIX"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- 1. Call Screening -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Call screening:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagCallScreening"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 2. Microphone Permission -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Microphone permission:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagMicPermission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GRANTED"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 3. Notifications Permission -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Notifications:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GRANTED"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 4. AudioRecord Capability -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AudioRecord:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagAudioRecord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 5. Audio Signal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Audio signal:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagAudioSignal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DETECTED"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 6. Speech Recognition -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Speech recognition:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagSpeechRecognition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 7. Live Call Audio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Live call audio:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagLiveCallAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PLATFORM LIMITED"
                            android:textStyle="bold"
                            android:textColor="@color/accent_amber"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" />

                    <!-- 8. Analysis Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Analysis mode:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDiagAnalysisMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IDLE"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD 1: AUDIO RECORD TEST ================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUDIO RECORD TEST"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tests Microphone → AudioRecord → 16kHz 16-bit Mono PCM. Verifies physical acoustic capture and measures non-zero samples and peak RMS. (Does NOT prove remote cellular call audio)."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Duration Selector Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recording duration"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinnerAudioDuration"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_spinner_rounded"
                            android:paddingHorizontal="12dp"
                            android:spinnerMode="dropdown" />

                        <!-- Custom Duration Input (Visible only when Custom is chosen) -->
                        <LinearLayout
                            android:id="@+id/layoutCustomDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Custom seconds (1–300):"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etCustomDuration"
                                android:layout_width="100dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:background="#0F172A"
                                android:paddingHorizontal="8dp"
                                android:inputType="number"
                                android:text="45"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Control Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnStartAudioRecord"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="START RECORDING"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            app:backgroundTint="@color/accent_green" />

                        <Button
                            android:id="@+id/btnStopAudioRecord"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="STOP"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:backgroundTint="@color/accent_red" />
                    </LinearLayout>

                    <!-- LIVE METRICS CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutLiveAudioMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:background="#0F172A"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/tvLiveTimer"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ready: 00:00 / 00:30"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvAudioRecordState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● IDLE"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginBottom="8dp" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2">

                            <!-- Current RMS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:padding="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Current RMS:"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLiveCurrentRms"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.0"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:fontFamily="monospace" />
                            </LinearLayout>

                            <!-- Peak RMS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:padding="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Peak RMS:"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLivePeakRms"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.0"
                                    android:textColor="@color/accent_green"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:fontFamily="monospace" />
                            </LinearLayout>

                            <!-- Samples Read -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:padding="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Samples read:"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLiveSamplesRead"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="monospace" />
                            </LinearLayout>

                            <!-- Non-zero samples -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical"
                                android:padding="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Non-zero samples:"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLiveNonZeroSamples"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </GridLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginVertical="6dp" />

                        <!-- Signal State -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Signal:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvLiveSignalState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● SILENCE"
                                android:textColor="@color/accent_amber"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- FINAL RESULTS BOX -->
                    <TextView
                        android:id="@+id/tvAudioRecordResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#0A0F1D"
                        android:padding="12dp"
                        android:fontFamily="monospace"
                        android:text="Diagnostic status: Idle. Select duration and tap START RECORDING."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD 2: SPEECH RECOGNITION TEST ================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEECH RECOGNITION TEST"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tests Android system SpeechRecognizer → Transcript. This session runs independently from AudioRecord without artificial time cutoffs."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Instruction Prompt Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#0F172A"
                        android:padding="10dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suggested test phrase:"
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&quot;Hello, this is a Svara X microphone test. I am checking whether the application can recognize my speech. This is a longer diagnostic recording.&quot;"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontStyle="italic"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <!-- Speech Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStartSpeechTest"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="START SPEECH TEST"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            app:backgroundTint="@color/accent_green" />

                        <Button
                            android:id="@+id/btnStopSpeechTest"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="STOP"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:backgroundTint="@color/accent_red" />
                    </LinearLayout>

                    <!-- Speech Recognition Output Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status: "
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvSpeechStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IDLE"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Partial transcript:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvPartialTranscript"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/accent_amber"
                            android:textSize="13sp"
                            android:fontStyle="italic"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Final transcript:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvFinalTranscript"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No speech recognized yet."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <!-- LIVE FRAUD PIPELINE STATUS (Part A & B Validation) -->
                    <LinearLayout
                        android:id="@+id/layoutSpeechFraudPipeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#0A0F1D"
                        android:padding="12dp"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE FRAUD DETECTION PIPELINE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <!-- Stage: STT to Pipeline -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Transcript Pipeline:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvSpeechPipelineDispatch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WAITING FOR SPEECH"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Stage: FraudDetector -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="FraudDetector:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvSpeechPipelineFraud"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STANDBY"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Stage: RiskEngine -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RiskEngine:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvSpeechPipelineRisk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STANDBY"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Stage: AlertManager -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AlertManager:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvSpeechPipelineAlert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STANDBY"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Indicators list -->
                        <TextView
                            android:id="@+id/tvSpeechPipelineIndicators"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detected indicators: None"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp" />

                        <!-- Recommendation -->
                        <TextView
                            android:id="@+id/tvSpeechPipelineRecommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Action: Awaiting speech analysis"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp" />

                        <!-- History persistence status -->
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginVertical="6dp" />

                        <TextView
                            android:id="@+id/tvSpeechHistoryStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Call History: Ready to save session record on Stop"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Telephony Restrictions Explanation -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANDROID TELEPHONY RESTRICTIONS"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• MediaRecorder.AudioSource.VOICE_DOWNLINK and VOICE_CALL require privileged OEM system signatures.\n• Third-party apps on Android cannot record cellular remote call audio when speakerphone is OFF.\n• Svara_X legitimately monitors calls, detects telephony transitions, and triggers warnings without injecting fabricated live call audio."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
