<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHistoryItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Caller & Risk Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgHistoryStatusIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_phone_call"
                android:contentDescription="Call" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryCaller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+91 98765 43210"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistoryDateDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today, 10:42 AM • 45s"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHistoryRiskScoreBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/surface_dark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="94% CRITICAL"
                android:textColor="@color/accent_red"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Detected Indicators Summary -->
        <TextView
            android:id="@+id/tvHistoryIndicators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⚠ OTP Request, Bank Impersonation, Urgency Pressure"
            android:textColor="@color/accent_amber"
            android:textSize="12sp" />

        <!-- Recommendation -->
        <TextView
            android:id="@+id/tvHistoryRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Recommendation: DO NOT SHARE OTP. DISCONNECT IMMEDIATELY."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
